# elib-service — Giai đoạn 1 (máy Linux của công ty)
# Sao chép thành .env rồi điền giá trị thật. Không commit .env.

# --- Chỉ dùng khi chạy bằng Docker Compose (docker-compose.yml đọc các biến này) ---
# Tài khoản/DB PostgreSQL trong container. ĐỔI mật khẩu trước khi chạy thật;
# nên dùng ký tự an toàn cho URL (chữ/số) vì compose ghép vào DATABASE_URL.
POSTGRES_USER=elib
POSTGRES_DB=elib
POSTGRES_PASSWORD=change-me

# PostgreSQL, ví dụ: postgres://elib:matkhau@localhost:5432/elib
# Khi chạy Docker Compose, biến này bị compose ghi đè bằng DATABASE_URL dựng từ
# POSTGRES_* ở trên (trỏ tới service postgres). Chỉ cần điền đúng khi chạy Node trực tiếp.
DATABASE_URL=postgres://elib:change-me@localhost:5432/elib

# Thư mục gốc lưu file trên ổ đĩa (tuyệt đối). File nằm ở:
#   {STORAGE_ROOT}/originals/{doc_id}/v{version}/{file_id}.{ext}
# Thư mục tạm nằm ở {STORAGE_ROOT}/tmp (cùng ổ đĩa để rename nguyên tử).
STORAGE_ROOT=/data/elib-storage

# Giới hạn dung lượng mỗi file (MB)
MAX_UPLOAD_MB=200

# Cổng HTTP của dịch vụ elib (chạy độc lập ở Giai đoạn 1)
PORT=3200
HOST=0.0.0.0

# Khóa ký session (chuỗi ngẫu nhiên dài). Đổi ở môi trường thật.
SESSION_SECRET=change-me-to-a-long-random-string

# Cookie Secure: để true khi người dùng vào qua HTTPS (Docker Compose +
# Reverse_proxy/Caddy). Chỉ đặt false khi chạy HTTP thuần trong LAN.
COOKIE_SECURE=true

# Thời hạn session (ngày)
SESSION_TTL_DAYS=7

# Tin header X-Forwarded-For khi đứng sau Reverse_proxy/Caddy (rate limit tính
# theo IP thật của người dùng). Chỉ đặt true khi thật sự có proxy tin cậy phía trước.
TRUST_PROXY=false

LOG_LEVEL=info
