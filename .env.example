# elib-service — Giai đoạn 1 (máy Linux của công ty)
# Sao chép thành .env rồi điền giá trị thật. Không commit .env.

# --- Chỉ dùng khi chạy bằng Docker Compose (docker-compose.yml đọc các biến này) ---
# Tài khoản/DB PostgreSQL trong container. ĐỔI mật khẩu trước khi chạy thật;
# nên dùng ký tự an toàn cho URL (chữ/số) vì compose ghép vào DATABASE_URL.
POSTGRES_USER=elib
POSTGRES_DB=elib
POSTGRES_PASSWORD=change-me

# PostgreSQL, ví dụ: postgres://elib:matkhau@localhost:5432/elib
# Khi chạy Docker Compose, biến này bị compose ghi đè bằng DATABASE_URL dựng từ
# POSTGRES_* ở trên (trỏ tới service postgres). Chỉ cần điền đúng khi chạy Node trực tiếp.
DATABASE_URL=postgres://elib:change-me@localhost:5432/elib

# Thư mục gốc lưu file trên ổ đĩa (tuyệt đối). File nằm ở:
#   {STORAGE_ROOT}/originals/{doc_id}/v{version}/{file_id}.{ext}
# Thư mục tạm nằm ở {STORAGE_ROOT}/tmp (cùng ổ đĩa để rename nguyên tử).
STORAGE_ROOT=/data/elib-storage

# Giới hạn dung lượng mỗi file (MB)
MAX_UPLOAD_MB=200

# Cổng HTTP của dịch vụ elib (chạy độc lập ở Giai đoạn 1)
PORT=3200
HOST=0.0.0.0

# Khóa ký session (chuỗi ngẫu nhiên dài). Đổi ở môi trường thật.
SESSION_SECRET=change-me-to-a-long-random-string

# Cookie Secure: để true khi người dùng vào qua HTTPS (Docker Compose +
# Reverse_proxy/Caddy). Chỉ đặt false khi chạy HTTP thuần trong LAN.
COOKIE_SECURE=true

# Thời hạn session (ngày)
SESSION_TTL_DAYS=7

# Tin header X-Forwarded-For khi đứng sau Reverse_proxy/Caddy (rate limit tính
# theo IP thật của người dùng). Chỉ đặt true (= đúng 1 hop) khi thật sự có đúng
# một lớp proxy tin cậy phía trước; có thể đặt số hop (vd 2). false = không tin.
TRUST_PROXY=false

# --- Đăng ký tài khoản + duyệt admin (Giai đoạn A3) ---
# Trần số tài khoản đang chờ duyệt; vượt trần thì đăng ký bị từ chối.
MAX_PENDING_USERS=200
# Khóa tạm đăng nhập: sai quá số lần này theo (username+IP) thì khóa tạm số phút.
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15
# Rate limit đăng ký/đăng nhập theo IP.
REGISTER_RATE_MAX=5
REGISTER_RATE_WINDOW_MINUTES=60
LOGIN_RATE_MAX=20
LOGIN_RATE_WINDOW_MINUTES=15
# Tên miền email nội bộ (phân cách dấu phẩy) — chỉ để gợi ý trên trang duyệt,
# không tự duyệt/tự gán loại người dùng. Ví dụ: congty.vn,tecco.vn
INTERNAL_EMAIL_DOMAINS=

# Bí mật dùng chung cho API nội bộ /internal/standards/* (metadata tiêu
# chuẩn): Reverse_proxy gửi qua header X-Internal-Token. Đặt cùng một chuỗi
# ngẫu nhiên dài ở cả hai phía; để trống = API nội bộ tắt (trả 503).
STANDARDS_INTERNAL_TOKEN=

# --- Xem trước giới hạn trang (preview) ---
# Tỉ lệ số trang được xem trước: preview = min(max(1, ceil(tổng × RATIO)), MAX).
# Chỉ chấp nhận (0, 1]; giá trị sai rơi về 0.2.
PREVIEW_RATIO=0.2
# Trần số trang xem trước.
PREVIEW_MAX_PAGES=10
# File gốc lớn hơn mức này (MB) sẽ không tạo bản xem trước.
PREVIEW_MAX_FILE_MB=50
# Chu kỳ poll của job nền tạo bản xem trước (ms).
PREVIEW_JOB_INTERVAL_MS=5000
# Job đang xử lý quá số phút này được nhả lại thành chờ xử lý.
PREVIEW_LOCK_STALE_MINUTES=15
# Timeout xử lý mỗi file (ms).
PREVIEW_FILE_TIMEOUT_MS=60000
# Bật job nền tạo bản xem trước trong server.
PREVIEW_JOB_ENABLED=true
# Đường dẫn binary qpdf cho PDF mã hóa có user password rỗng (tùy chọn, mặc định 'qpdf').
# QPDF_PATH=qpdf

LOG_LEVEL=info
